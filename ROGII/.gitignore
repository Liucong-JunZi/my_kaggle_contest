# Don't track unfinished experiment artifacts until they have metrics.json
# (override per-config by `git add -f <path>` when committing a finished run)

# Round-NNN artifacts (parquet/CSV/HDF5/pth) — only track per-round notes/scripts
results/round_*/
catboost_info/
data/cache/
*.parquet
*.h5
*.hdf5
*.pth

# round_010 generated artifacts (kept out of git — too large, regenerable)
experiments/round_010/results/candidates/
experiments/round_010/results/joined_features.parquet
experiments/round_010/results/global_folds.parquet
experiments/round_010/results/hillclimb_runs/*_oof.parquet
experiments/round_010/catboost_info/

# Public resource harvest — raw downloads not tracked, only digested notes
experiments/public_resources/kernels_raw/
experiments/public_resources/datasets_raw/
experiments/public_resources/forum_raw/

# Stray Kaggle kernel staging dirs (used for `kaggle kernels push`)
kaggle_kernels/
/tmp_kernel*/

# Stray top-level kernel logs from `kaggle kernels output`
/r*-rogii-*.log
/v*_out/

# Generated submission CSVs (regenerable)
experiments/round_009/submission.csv
experiments/round_010/submission_v3.csv

# round_010 logs (regenerable)
experiments/round_010/logs/
experiments/round_010/results/candidates_logs/
experiments/round_010/*.log

